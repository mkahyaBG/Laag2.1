<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.min.js"></script>
<script src="/api/env" defer></script>

<script>
// ═══════════════════════════════════════════════════════════
// SUPABASE & TOEGANGSMUUR — AI & Data Assessment (LAAG 2.1)
// ═══════════════════════════════════════════════════════════
let _supa = null;

function initSupabase() {
  const url = window.__ENV_SUPABASE_URL__;
  const key = window.__ENV_SUPABASE_ANON_KEY__;
  if (url && key && window.supabase) {
    _supa = window.supabase.createClient(url, key);
  }
}

// Actieve sessievariabelen
let activeCode = '';
let sessionId = null;
let existingSession = null;

// ── INVOERVELD FOUT WISSEN ──
function clearGateInputError() {
  document.getElementById('gate-code-error').classList.remove('visible');
  document.getElementById('gate-code-input').classList.remove('error');
}

// ── CODE INDIENEN ──
async function submitCode() {
  const rawInput = document.getElementById('gate-code-input').value.trim().toUpperCase();
  if (!rawInput) return;
  const btn = document.getElementById('gate-submit-btn');
  btn.disabled = true; btn.textContent = 'Controleren…';

  try {
    const { data: codeRow, error } = await _supa
      .from('access_codes')
      .select('code, is_active, client_name')
      .eq('code', rawInput)
      .single();

    if (error || !codeRow || !codeRow.is_active) {
      document.getElementById('gate-code-error').textContent = 'Ongeldige of inactieve code. Controleer uw code en probeer het opnieuw.';
      document.getElementById('gate-code-error').classList.add('visible');
      document.getElementById('gate-code-input').classList.add('error');
      btn.disabled = false; btn.textContent = 'Toegang →';
      return;
    }

    activeCode = rawInput;

    // Controleer of er al een sessie bestaat voor deze code
    const { data: sessions } = await _supa
      .from('assessment_sessions')
      .select('*')
      .eq('access_code', rawInput)
      .eq('status', 'in_progress')
      .order('updated_at', { ascending: false })
      .limit(1);

    if (sessions && sessions.length > 0) {
      existingSession = sessions[0];
      showResumeNotice(sessions[0]);
    } else {
      existingSession = null;
      proceedToIntro();
    }
  } catch (e) {
    document.getElementById('gate-code-error').textContent = 'Er ging iets mis. Probeer het opnieuw of neem contact op met BG.legal.';
    document.getElementById('gate-code-error').classList.add('visible');
  }
  btn.disabled = false; btn.textContent = 'Toegang →';
}

// ── HERVATTINGSMELDING TONEN ──
function showResumeNotice(session) {
  const notice = document.getElementById('resume-notice');
  const updated = new Date(session.updated_at).toLocaleDateString('nl-NL', {
    day: '2-digit', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit'
  });
  document.getElementById('resume-notice-text').textContent =
    'Uw laatste voortgang is opgeslagen op ' + updated + '. Wilt u verdergaan of opnieuw beginnen?';
  notice.classList.add('visible');
  document.getElementById('gate-code-input').disabled = true;
  document.getElementById('gate-submit-btn').style.display = 'none';
}

// ── SESSIE HERVATTEN ──
function resumeSession() {
  if (!existingSession) return;
  sessionId = existingSession.id;
  answers = existingSession.answers || {};
  idData = existingSession.identification || {};
  currentIdx = existingSession.current_index || 0;
  history = [];
  showScreen('screen-question');
  renderQ();
}

// ── OPNIEUW BEGINNEN ──
function startFresh() {
  existingSession = null;
  document.getElementById('resume-notice').classList.remove('visible');
  document.getElementById('gate-code-input').disabled = false;
  document.getElementById('gate-submit-btn').style.display = 'flex';
  document.getElementById('gate-submit-btn').disabled = false;
  document.getElementById('gate-submit-btn').textContent = 'Toegang →';
  clearGateInputError();
  proceedToIntro();
}

function proceedToIntro() {
  showScreen('screen-intro');
}

// ── VOORTGANG OPSLAAN ──
async function saveProgress() {
  if (!_supa || !activeCode) return;
  const payload = {
    access_code: activeCode,
    answers: answers,
    identification: idData,
    current_index: currentIdx,
    status: 'in_progress',
    updated_at: new Date().toISOString()
  };
  if (sessionId) {
    await _supa.from('assessment_sessions').update(payload).eq('id', sessionId);
  } else {
    const { data } = await _supa.from('assessment_sessions').insert(payload).select().single();
    if (data) sessionId = data.id;
  }
}

// ── SESSIE AFSLUITEN ──
async function markComplete() {
  if (!_supa || !sessionId) return;
  await _supa.from('assessment_sessions').update({
    status: 'completed',
    completed_at: new Date().toISOString(),
    updated_at: new Date().toISOString(),
    answers: answers,
    identification: idData
  }).eq('id', sessionId);
}
</script>
