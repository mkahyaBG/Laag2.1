<!DOCTYPE html>
<html lang="nl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AI & Data assessment</title>
<link href="https://api.fontshare.com/v2/css?f[]=switzer@300,400,500,600,700&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<style>
  :root {
    --ink: #2F302F; --paper: #DEDAC6; --cream: #ede8dc;
    --accent: #B9B9EB; --accent-dark: #8585cc; --accent-light: #f0eff9;
    --muted: #7a7468; --white: #fdfaf5;
    --green: #2d7a5f; --green-light: #e4f0eb;
    --red: #c8401e; --red-light: #f5e8e4;
    --amber: #c9841e; --amber-light: #f5ede0;
    --border: rgba(47,48,47,.12);
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'Switzer', sans-serif; background: var(--paper); color: var(--ink); min-height: 100vh; overflow-x: hidden; }
  body::before { content: ''; position: fixed; inset: 0; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E"); pointer-events: none; z-index: 9999; opacity: 0.4; }

  /* ── SCREENS ── */
  .screen { display: none; animation: fadeUp 0.45s ease; }
  .screen.active { display: block; }
  @keyframes fadeUp { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: translateY(0); } }

  /* ── INTRO ── */
  #screen-intro { max-width: 800px; margin: 0 auto; padding: 80px 48px 60px; text-align: center; }
  .eyebrow { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent-dark); margin-bottom: 22px; display: flex; align-items: center; justify-content: center; gap: 8px; }
  .eyebrow::before, .eyebrow::after { content: ''; display: block; width: 40px; height: 1px; background: var(--accent-dark); opacity: 0.5; }
  h1 { font-family: 'Switzer', sans-serif; font-size: clamp(2.4rem, 5vw, 3.8rem); line-height: 1.1; letter-spacing: -0.02em; color: var(--ink); margin-bottom: 24px; }
  h1 em { font-style: normal; color: var(--accent-dark); }
  .hero-sub { font-size: 1.05rem; line-height: 1.7; color: var(--muted); font-weight: 300; max-width: 580px; margin: 0 auto 48px; }
  .meta-row { display: flex; justify-content: center; gap: 32px; margin-bottom: 48px; flex-wrap: wrap; }
  .meta-item { display: flex; align-items: center; gap: 8px; font-size: 0.88rem; color: var(--muted); }
  .btn-primary { display: inline-flex; align-items: center; gap: 10px; background: var(--ink); color: var(--white); font-family: 'Switzer', sans-serif; font-size: 0.95rem; font-weight: 500; padding: 18px 40px; border: none; border-radius: 4px; cursor: pointer; transition: all 0.25s ease; letter-spacing: 0.01em; }
  .btn-primary:hover { background: var(--accent-dark); transform: translateY(-2px); box-shadow: 0 12px 30px rgba(133,133,204,0.35); }
  .btn-primary .arrow { transition: transform 0.25s ease; }
  .btn-primary:hover .arrow { transform: translateX(4px); }
  .coverage-row { margin-top: 64px; padding-top: 40px; border-top: 1px solid rgba(13,13,13,0.1); }
  .coverage-label { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); margin-bottom: 16px; }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; }
  .tag { background: var(--cream); border: 1px solid rgba(13,13,13,0.1); font-size: 0.78rem; font-weight: 500; padding: 5px 12px; border-radius: 3px; color: var(--ink); }

  /* ── IDENTIFICATION ── */
  #screen-identification { max-width: 900px; margin: 0 auto; padding: 60px 48px 80px; }
  .screen-header { margin-bottom: 40px; }
  .screen-eyebrow { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent-dark); margin-bottom: 10px; display: flex; align-items: center; gap: 8px; }
  .screen-eyebrow::before { content: ''; display: block; width: 24px; height: 1px; background: var(--accent-dark); opacity: 0.5; }
  .screen-title { font-family: 'Switzer', sans-serif; font-size: clamp(1.6rem, 3vw, 2.4rem); letter-spacing: -0.02em; line-height: 1.2; }
  .screen-title em { font-style: normal; color: var(--accent-dark); }
  .screen-sub { font-size: 0.9rem; color: var(--muted); font-weight: 300; line-height: 1.65; margin-top: 10px; max-width: 620px; }
  .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .form-field { display: flex; flex-direction: column; gap: 6px; }
  .form-field.full { grid-column: 1 / -1; }
  .form-label { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
  .form-input, .form-textarea { font-family: 'Switzer', sans-serif; font-size: 0.95rem; color: var(--ink); background: var(--white); border: 1.5px solid rgba(13,13,13,0.18); border-radius: 6px; padding: 13px 16px; outline: none; transition: border-color 0.2s; }
  .form-input:focus, .form-textarea:focus { border-color: var(--accent-dark); }
  .form-input.error { border-color: var(--red); }
  .form-textarea { resize: vertical; min-height: 110px; line-height: 1.6; }
  .form-error { font-size: 0.78rem; color: var(--red); display: none; }
  .form-error.visible { display: block; }

  /* ── QUESTION SCREEN ── */
  #screen-question { max-width: 900px; margin: 0 auto; padding: 52px 48px 80px; }
  .progress-area { margin-bottom: 28px; }
  .progress-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
  .progress-module { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent-dark); }
  .progress-count { font-size: 0.78rem; font-weight: 600; color: var(--muted); }
  .progress-track { height: 3px; background: rgba(13,13,13,0.12); border-radius: 2px; overflow: hidden; }
  .progress-fill { height: 100%; background: var(--accent-dark); transition: width 0.5s cubic-bezier(0.4,0,0.2,1); border-radius: 2px; }
  .module-breadcrumb { display: flex; align-items: center; gap: 8px; margin-bottom: 22px; flex-wrap: wrap; }
  .crumb { font-size: 0.66rem; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; color: var(--muted); padding: 4px 8px; border-radius: 3px; background: var(--cream); border: 1px solid var(--border); }
  .crumb.active { background: var(--accent-light); color: var(--accent-dark); border-color: var(--accent); }
  .question-id { font-size: 0.65rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); margin-bottom: 6px; margin-top: 24px; }
  .question-text { font-family: 'Switzer', sans-serif; font-size: clamp(1.2rem, 2.2vw, 1.75rem); line-height: 1.3; letter-spacing: -0.02em; color: var(--ink); margin-bottom: 12px; }
  .question-hint { font-size: 0.875rem; color: var(--muted); font-weight: 300; line-height: 1.6; background: var(--cream); border-left: 3px solid var(--accent-dark); padding: 10px 14px; border-radius: 0 4px 4px 0; margin-bottom: 26px; }
  .options-list { display: flex; flex-direction: column; gap: 10px; margin-bottom: 36px; }
  .option-btn { background: var(--white); border: 1.5px solid rgba(13,13,13,0.12); border-radius: 6px; padding: 16px 18px; text-align: left; cursor: pointer; transition: all 0.2s ease; display: flex; align-items: flex-start; gap: 14px; font-family: 'Switzer', sans-serif; width: 100%; }
  .option-btn:hover { border-color: var(--accent-dark); background: var(--accent-light); transform: translateY(-1px); box-shadow: 0 6px 18px rgba(13,13,13,0.07); }
  .option-btn.selected { border-color: var(--accent-dark); background: var(--accent-light); box-shadow: 0 0 0 3px rgba(133,133,204,0.15); }
  .option-indicator { width: 20px; height: 20px; min-width: 20px; border: 1.5px solid rgba(13,13,13,0.2); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-top: 2px; transition: all 0.2s ease; flex-shrink: 0; }
  .option-btn.selected .option-indicator { border-color: var(--accent-dark); background: var(--accent-dark); }
  .option-btn.selected .option-indicator::after { content: ''; width: 7px; height: 7px; background: white; border-radius: 50%; display: block; }
  .option-label { font-size: 0.92rem; font-weight: 500; color: var(--ink); line-height: 1.4; }
  .option-btn.checkbox .option-indicator { border-radius: 4px; }
  .option-btn.checkbox.selected .option-indicator::after { content: '✓'; font-size: 0.75rem; border-radius: 0; background: transparent; color: white; width: auto; height: auto; font-weight: 700; }
  .nav-row { display: flex; justify-content: space-between; align-items: center; margin-top: 8px; padding-top: 24px; border-top: 1px solid rgba(13,13,13,0.1); }
  .btn-back { background: none; border: none; font-family: 'Switzer', sans-serif; font-size: 0.9rem; color: var(--muted); cursor: pointer; display: flex; align-items: center; gap: 6px; padding: 8px 0; transition: color 0.2s; }
  .btn-back:hover { color: var(--ink); }
  .btn-next { background: var(--ink); color: var(--white); font-family: 'Switzer', sans-serif; font-size: 0.9rem; font-weight: 500; padding: 14px 32px; border: none; border-radius: 4px; cursor: pointer; display: flex; align-items: center; gap: 8px; transition: all 0.2s ease; opacity: 0.35; pointer-events: none; }
  .btn-next.enabled { opacity: 1; pointer-events: all; }
  .btn-next.enabled:hover { background: var(--accent-dark); transform: translateY(-1px); }

  /* ── EMAIL GATE ── */
  #screen-email { max-width: 560px; margin: 0 auto; padding: 100px 48px 80px; text-align: center; }
  .email-icon { width: 64px; height: 64px; background: var(--accent-light); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 32px; font-size: 1.6rem; }
  .email-gate-title { font-family: 'Switzer', sans-serif; font-size: clamp(1.8rem, 4vw, 2.6rem); letter-spacing: -0.02em; line-height: 1.15; margin-bottom: 16px; }
  .email-gate-title em { font-style: normal; color: var(--accent-dark); }
  .email-gate-sub { font-size: 0.95rem; color: var(--muted); font-weight: 300; line-height: 1.7; margin-bottom: 40px; max-width: 420px; margin-left: auto; margin-right: auto; }
  .email-fields { display: flex; flex-direction: column; gap: 12px; margin: 0 auto 14px; max-width: 520px; }
  .email-submit { width: 100%; justify-content: center; background: var(--ink); color: var(--white); font-family: 'Switzer', sans-serif; font-size: 1rem; font-weight: 500; padding: 18px 32px; border: none; border-radius: 6px; cursor: pointer; transition: all 0.25s ease; display: flex; align-items: center; }
  .email-submit:hover { background: var(--accent-dark); transform: translateY(-2px); box-shadow: 0 12px 30px rgba(133,133,204,0.35); }
  .privacy-note { font-size: 0.75rem; color: var(--muted); margin-top: 14px; line-height: 1.6; font-weight: 300; }
  .email-input-field { font-family: 'Switzer', sans-serif; font-size: 1rem; color: var(--ink); background: var(--white); border: 1.5px solid rgba(13,13,13,0.18); border-radius: 6px; padding: 16px 20px; width: 100%; outline: none; transition: border-color 0.2s; }
  .email-input-field:focus { border-color: var(--accent-dark); }
  .email-input-field.error { border-color: var(--red); }
  .email-error { font-size: 0.8rem; color: var(--red); display: none; text-align: left; }
  .email-error.visible { display: block; }

  /* ── RESULTS ── */
  #screen-results { max-width: 980px; margin: 0 auto; padding: 60px 48px 80px; }
  .results-hero { margin-bottom: 42px; padding-bottom: 34px; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 24px; }
  .results-title { font-family: 'Switzer', sans-serif; font-size: clamp(1.8rem, 3.5vw, 2.8rem); letter-spacing: -0.02em; line-height: 1.15; }
  .results-title em { font-style: normal; color: var(--accent-dark); }
  .results-meta { font-size: 0.88rem; color: var(--muted); font-weight: 300; margin-top: 8px; }
  .overall-verdict { display: inline-flex; align-items: center; gap: 6px; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; padding: 5px 6px; border-radius: 100px; width: fit-content; }
  .overall-verdict.critical { background: #2a0a0a; color: #ff8c8c; }
  .overall-verdict.high { background: var(--red-light); color: var(--red); }
  .overall-verdict.medium { background: var(--amber-light); color: var(--amber); }
  .overall-verdict.low { background: var(--green-light); color: var(--green); }
  .section-title { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); margin-bottom: 18px; margin-top: 48px; display: flex; align-items: center; gap: 10px; }
  .section-title::after { content: ''; flex: 1; height: 1px; background: var(--border); }
  .verdict-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 14px; }
  .verdict-card { background: var(--white); border: 1.5px solid rgba(13,13,13,0.1); border-radius: 8px; padding: 18px 20px; }
  .verdict-card-label { font-size: 0.68rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); margin-bottom: 8px; }
  .verdict-card-value { font-family: 'Switzer', sans-serif; font-size: 1.1rem; color: var(--ink); line-height: 1.3; }
  .verdict-card-value.red { color: var(--red); }
  .verdict-card-value.amber { color: var(--amber); }
  .verdict-card-value.green { color: var(--green); }
  .flags-list { display: flex; flex-direction: column; gap: 12px; }
  .flag-card { background: var(--white); border: 1.5px solid rgba(13,13,13,0.1); border-radius: 8px; padding: 20px 22px; display: flex; gap: 16px; align-items: flex-start; }
  .flag-card.critical { background: var(--red-light); border-color: var(--red); }
  .flag-card.high { background: var(--amber-light); border-color: var(--amber); }
  .flag-icon { width: 38px; height: 38px; min-width: 38px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 1.1rem; flex-shrink: 0; background: var(--cream); border: 1px solid var(--border); }
  .flag-body { flex: 1; }
  .flag-level { font-size: 0.66rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 5px; display: inline-block; padding: 2px 8px; border-radius: 3px; }
  .flag-level.critical { color: var(--red); background: rgba(200,64,30,0.1); }
  .flag-level.high { color: var(--amber); background: rgba(201,132,30,0.1); }
  .flag-level.medium { color: var(--muted); background: rgba(122,116,104,0.12); }
  .flag-level.info { color: var(--green); background: rgba(45,122,95,0.1); }
  .flag-name { font-weight: 600; font-size: 0.95rem; color: var(--ink); margin-bottom: 6px; }
  .flag-desc { font-size: 0.84rem; color: var(--muted); line-height: 1.6; font-weight: 300; }
  .answers-table { width: 100%; border-collapse: collapse; font-size: 0.84rem; margin-top: 8px; }
  .answers-table th { text-align: left; font-size: 0.68rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); padding: 8px 12px; background: var(--cream); border-bottom: 2px solid var(--border); }
  .answers-table td { padding: 10px 12px; border-bottom: 1px solid rgba(47,48,47,0.06); vertical-align: top; line-height: 1.5; }
  .answers-table tr:hover td { background: rgba(13,13,13,0.02); }

  /* ── DOWNLOAD BAR ── */
  .download-bar { background: var(--white); border: 1.5px solid rgba(133,133,204,0.35); border-radius: 8px; padding: 18px 22px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 14px; margin: 40px 0 22px; }
  .download-title { font-weight: 600; font-size: 0.93rem; color: var(--ink); }
  .download-sub { font-size: 0.78rem; color: var(--muted); font-weight: 300; margin-top: 2px; }
  .btn-download { background: var(--ink); color: var(--white); font-family: 'Switzer', sans-serif; font-size: 0.88rem; font-weight: 500; padding: 11px 22px; border: none; border-radius: 4px; cursor: pointer; white-space: nowrap; transition: all 0.2s; }
  .btn-download:hover { background: var(--accent-dark); transform: translateY(-1px); }

  /* ── CTA BLOCK ── */
  .cta-block { background: var(--ink); border-radius: 10px; padding: 40px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 24px; margin-top: 32px; }
  .cta-text h3 { font-family: 'Switzer', sans-serif; font-size: 1.5rem; color: var(--white); margin-bottom: 6px; }
  .cta-text p { font-size: 0.88rem; color: rgba(255,255,255,0.55); font-weight: 300; }
  .btn-cta { background: var(--accent-dark); color: white; font-family: 'Switzer', sans-serif; font-size: 0.9rem; font-weight: 600; padding: 13px 24px; border: none; border-radius: 4px; cursor: pointer; transition: all 0.2s; }
  .btn-cta:hover { opacity: 0.88; transform: translateY(-1px); }
  .btn-restart { background: none; border: 1px solid rgba(255,255,255,0.2); color: rgba(255,255,255,0.65); font-family: 'Switzer', sans-serif; font-size: 0.85rem; padding: 13px 24px; border-radius: 4px; cursor: pointer; transition: all 0.2s; }
  .btn-restart:hover { border-color: rgba(255,255,255,0.5); color: white; }
  .disclaimer { font-size: 0.75rem; color: var(--muted); margin-top: 28px; line-height: 1.65; font-weight: 300; padding-top: 20px; border-top: 1px solid rgba(13,13,13,0.1); }

  @media (max-width: 720px) {
    header { padding: 20px 24px; }
    #screen-intro, #screen-identification, #screen-question, #screen-results, #screen-email { padding: 36px 24px 60px; }
    .meta-grid, .form-grid { grid-template-columns: 1fr; }
    .verdict-grid { grid-template-columns: 1fr; }
    .results-hero { flex-direction: column; align-items: flex-start; }
  }

/* ── TOEGANGSMUUR ── */
#screen-gate{max-width:520px;margin:0 auto;padding:100px 48px 80px;text-align:center;}
.gate-icon{width:72px;height:72px;background:var(--accent-light);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 32px;font-size:1.8rem;}
.gate-title{font-family:'Switzer',sans-serif;font-size:clamp(1.8rem,4vw,2.6rem);letter-spacing:-.02em;line-height:1.15;margin-bottom:12px;}
.gate-title em{font-style:normal;color:var(--accent-dark);}
.gate-sub{font-size:.95rem;color:var(--muted);font-weight:300;line-height:1.7;margin-bottom:36px;}
.gate-input-wrap{display:flex;flex-direction:column;gap:10px;margin-bottom:14px;}
.gate-input{font-family:'Switzer',sans-serif;font-size:1.1rem;text-align:center;letter-spacing:.12em;text-transform:uppercase;color:var(--ink);background:var(--white);border:1.5px solid rgba(13,13,13,.18);border-radius:6px;padding:16px 20px;width:100%;outline:none;transition:border-color .2s;}
.gate-input:focus{border-color:var(--accent-dark);}
.gate-input.error{border-color:var(--red);}
.gate-code-error{font-size:.82rem;color:var(--red);display:none;text-align:center;}
.gate-code-error.visible{display:block;}
.gate-submit{width:100%;justify-content:center;background:var(--ink);color:var(--white);font-family:'Switzer',sans-serif;font-size:1rem;font-weight:500;padding:18px 32px;border:none;border-radius:6px;cursor:pointer;transition:all .25s ease;display:flex;align-items:center;}
.gate-submit:hover{background:var(--accent-dark);transform:translateY(-2px);box-shadow:0 12px 30px rgba(133,133,204,.35);}
.gate-submit:disabled{opacity:.55;cursor:not-allowed;transform:none;box-shadow:none;}
.resume-notice{background:var(--accent-light);border:1.5px solid var(--accent);border-radius:8px;padding:18px 20px;margin-bottom:24px;display:none;}
.resume-notice.visible{display:block;}
.resume-notice-title{font-weight:600;font-size:.95rem;color:var(--accent-dark);margin-bottom:6px;}
.resume-notice-text{font-size:.84rem;color:var(--muted);line-height:1.6;margin-bottom:14px;}
.resume-btns{display:flex;gap:10px;flex-wrap:wrap;}
.btn-resume{background:var(--accent-dark);color:white;font-family:'Switzer',sans-serif;font-size:.88rem;font-weight:600;padding:10px 20px;border:none;border-radius:4px;cursor:pointer;transition:all .2s;}
.btn-resume-new{background:none;border:1.5px solid var(--border);color:var(--muted);font-family:'Switzer',sans-serif;font-size:.88rem;padding:10px 20px;border-radius:4px;cursor:pointer;transition:all .2s;}
.btn-resume-new:hover{border-color:var(--ink);color:var(--ink);}
.gate-privacy{font-size:.72rem;color:var(--muted);margin-top:14px;line-height:1.6;font-weight:300;}
</style>
</head>
<body>


<!-- TOEGANGSMUUR -->
<div id="screen-gate" class="screen active">
  <div class="gate-icon">🔐</div>
  <div class="gate-title">Welkom bij het <em>AI &amp; Data Assessment</em></div>
  <p class="gate-sub">Dit assessment is uitsluitend toegankelijk voor BG.legal cliënten. Voer uw persoonlijke toegangscode in om te beginnen.</p>
  <div class="resume-notice" id="resume-notice">
    <div class="resume-notice-title">U heeft dit assessment eerder begonnen</div>
    <div class="resume-notice-text" id="resume-notice-text">Wilt u verdergaan waar u gebleven was, of opnieuw beginnen?</div>
    <div class="resume-btns">
      <button class="btn-resume" onclick="resumeSession()">Verdergaan →</button>
      <button class="btn-resume-new" onclick="startFresh()">Opnieuw beginnen</button>
