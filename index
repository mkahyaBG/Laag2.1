<script>
const DATA=JSON.parse(document.getElementById('assessment-data').textContent);
const MODULES=DATA.modules;
const QUESTIONS=DATA.questions;
let answers={}, currentIdx=0, history=[], idData={}, userEmail='';
// Toegangsmuur variabelen (worden gezet door Supabase blok hierboven)
// activeCode, sessionId, existingSession worden gedeclareerd in het Supabase blok

function showScreen(id){document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));document.getElementById(id).classList.add('active');window.scrollTo(0,0);}
function showIdentification(){showScreen('screen-identification');}

function init(){
  setTimeout(initSupabase, 100);
  const mg=document.getElementById('module-grid');
  mg.innerHTML=Object.values(MODULES).map(m=>
    '<span class="tag">'+esc(m.short)+'</span>'
  ).join('');
}

function startAssessment(){
  const org=id('id_org').value.trim(), email=id('id_email').value.trim();
  if(!org||!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)){id('id-error').classList.add('visible');return;}
  idData={org,country:id('id_country').value.trim(),name:id('id_name').value.trim(),role:id('id_role').value.trim(),email,project:id('id_project').value.trim(),desc:id('id_desc').value.trim()};
  answers={};history=[];currentIdx=0;
  showScreen('screen-question');renderQ();
  saveProgress();
}

function id(x){return document.getElementById(x);}
function esc(s){return String(s??'').replace(/[&<>'"]/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[m]));}

function getVisible(){return QUESTIONS;}

function answerText(q){
  const v=answers[q.id];
  if(v===undefined||v===null||(Array.isArray(v)&&!v.length)) return '';
  if(Array.isArray(v)) return v.map(x=>(q.options.find(o=>o.value===x)||{}).label||x).join(' · ');
  return (q.options.find(o=>o.value===v)||{}).label||v;
}

function renderQ(){
  const vis=getVisible(), q=vis[currentIdx], pct=(currentIdx/vis.length)*100;
  id('q-progress').style.width=pct+'%';
  id('q-count').textContent=(currentIdx+1)+' / '+vis.length;
  id('q-module-label').textContent=MODULES[q.module].title;
  id('q-id').textContent='Vraag '+q.qid;
  id('q-text').textContent=q.text;
  const h=id('q-hint');
  if(q.hint){h.textContent=q.hint;h.style.display='block';}else h.style.display='none';
  id('module-breadcrumb').innerHTML=Object.keys(MODULES).map(k=>
    '<span class="crumb '+(k===q.module?'active':'')+'">'+esc(MODULES[k].short)+'</span>'
  ).join('');
  const list=id('options-list');
  list.innerHTML='';
  const cur=answers[q.id];
  q.options.forEach(opt=>{
    const sel=q.type==='multi'?Array.isArray(cur)&&cur.includes(opt.value):cur===opt.value;
    const b=document.createElement('button');
    b.className='option-btn '+(q.type==='multi'?'checkbox ':'')+(sel?'selected':'');
    b.innerHTML='<div class="option-indicator"></div><div><div class="option-label">'+esc(opt.label)+'</div></div>';
    b.onclick=()=>selectOpt(q,opt);
    list.appendChild(b);
  });
  id('btn-back').style.visibility=currentIdx===0?'hidden':'visible';
  updateNext();
}

function selectOpt(q,opt){
  if(q.type==='multi'){
    let cur=Array.isArray(answers[q.id])?[...answers[q.id]]:[];
    const isNone=/^(Geen|Nee|Niet van toepassing|Uitsluitend geaggregeerde)/i.test(opt.label);
    if(isNone){cur=[opt.value];}
    else{
      cur=cur.filter(v=>!(/^(Geen|Nee|Niet van toepassing|Uitsluitend geaggregeerde)/i.test((q.options.find(o=>o.value===v)||{}).label||'')));
      cur=cur.includes(opt.value)?cur.filter(v=>v!==opt.value):[...cur,opt.value];
    }
    answers[q.id]=cur;
    saveProgress();
  } else {
    answers[q.id]=opt.value;
    setTimeout(()=>{
      if(currentIdx<getVisible().length-1){history.push(currentIdx);currentIdx++;renderQ();}
      else showEmailScreen();
    },220);
  }
  renderQ();
}

function updateNext(){
  const q=getVisible()[currentIdx], v=answers[q.id];
  const ok=q.type==='multi'?Array.isArray(v)&&v.length>0:!!v;
  id('btn-next').classList.toggle('enabled',ok);
  id('btn-next').textContent=currentIdx===getVisible().length-1?'Bekijk resultaten →':'Volgende →';
}

function nextQ(){
  const q=getVisible()[currentIdx], v=answers[q.id];
  if(q.type==='multi'&&(!Array.isArray(v)||!v.length))return;
  if(q.type!=='multi'&&!v)return;
  history.push(currentIdx);
  if(currentIdx<getVisible().length-1){currentIdx++;saveProgress();renderQ();}else showEmailScreen();
}

function prevQ(){if(history.length){currentIdx=history.pop();renderQ();}}

function showEmailScreen(){
  id('gate-email').value=idData.email||'';
  showScreen('screen-email');
}
function clearGateError(){id('gate-error').classList.remove('visible');id('gate-email').classList.remove('error');}

function submitGate(){
  const e=id('gate-email').value.trim();
  if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(e)){id('gate-email').classList.add('error');id('gate-error').classList.add('visible');return;}
  userEmail=e;
  const btn=id('btn-gate-submit');
  btn.disabled=true;btn.textContent='Rapport genereren…';
  markComplete();
  sendEmails(e, buildReportText())
    .then(()=>{btn.textContent='Rapport verzonden ✓';setTimeout(()=>{showScreen('screen-results');renderResults();},700);})
    .catch(()=>{showScreen('screen-results');renderResults();});
}

async function sendEmails(toEmail, reportText) {
  // Verstuurt rapport via Scalingo server met PDF bijlage en BCC naar noreply@compliance-bg.legal
  let pdfBase64 = null;
  try { pdfBase64 = buildPDFBase64(); } catch(e) { console.warn('PDF fout:', e.message); }

  const response = await fetch('/api/send-email', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      to: toEmail,
      recipientName: idData.name || '',
      orgName: idData.org || '',
      appName: idData.project || '',
      toolName: 'AI & Data Assessment',
      reportText: reportText,
      pdfBase64: pdfBase64,
    }),
  });
  if (!response.ok) throw new Error('E-mail mislukt');
  return response.json();
}

function buildReportText(){
  const lines=[];
  const d=new Date().toLocaleDateString('nl-NL');
  lines.push('B1 QUICKSCAN AI & DATA — RAPPORT','');
  lines.push('Organisatie: '+(idData.org||''),'Project: '+(idData.project||''),'Invuller: '+(idData.name||''),'E-mail: '+(userEmail||idData.email||''),'Datum: '+d,'');
  lines.push('BESCHRIJVING',idData.desc||'','');
  lines.push('SAMENVATTING PER MODULE');
  moduleStats().forEach(s=>lines.push(MODULES[s.m].title+': '+s.answered+'/'+s.total+' beantwoord, '+s.flags.length+' aandachtspunt(en)'));
  lines.push('','RODE VLAGGEN');
  const flags=computeFlags();
  if(!flags.length) lines.push('Geen rode vlaggen geïdentificeerd.');
  flags.forEach((f,i)=>lines.push((i+1)+'. ['+f.level.toUpperCase()+'] '+f.module+' — '+f.name+' — '+f.desc));
  lines.push('','ANTWOORDEN');
  QUESTIONS.forEach(q=>lines.push(q.qid+' '+q.text+'\nAntwoord: '+(answerText(q)||'Niet beantwoord')));
  return lines.join('\n');
}

function severityFor(label){
  label=(label||'').toLowerCase();
  if(/ja of mogelijk|mogelijk|geen toestemming|niet gemeld|niet geregeld|geen procedure|nee —.*(niet|geen)|nee,.*niet/.test(label)) return 'critical';
  if(/weet ik niet|gedeeltelijk|in voorbereiding|in ontwikkeling|gepland|onzeker|nog niet|hybride/.test(label)) return 'high';
  if(/^nee/.test(label)&&!/geen van|niet van toepassing|uitsluitend|platform/.test(label)) return 'medium';
  return 'info';
}

function computeFlags(){
  const flags=[];
  for(const q of QUESTIONS){
    const ans=answerText(q);
    if(!ans) continue;
    const parts=ans.split(' · ');
    for(const p of parts){
      const sev=severityFor(p);
      if(sev==='critical'||sev==='high'){
        flags.push({level:sev,module:MODULES[q.module].short,name:q.qid+' — '+q.text.slice(0,90),desc:'Antwoord: '+p,
          action:sev==='critical'?'Direct juridisch of compliance-onderzoek uitvoeren.':'Nader beoordelen en waar nodig maatregelen treffen.'});
      }
    }
  }
  return flags;
}

function moduleStats(){
  return Object.keys(MODULES).map(m=>{
    const qs=QUESTIONS.filter(q=>q.module===m), answered=qs.filter(q=>answers[q.id]!==undefined).length;
    const fs=computeFlags().filter(f=>f.module===MODULES[m].short);
    return {m,answered,total:qs.length,flags:fs};
  });
}

function renderResults(){
  const d=new Date().toLocaleDateString('nl-NL',{day:'2-digit',month:'long',year:'numeric'});
  id('results-meta').textContent=(idData.name||'Invuller')+(idData.org?' · '+idData.org:'')+(idData.project?' · '+idData.project:'')+' · '+d;
  const flags=computeFlags();
  const critical=flags.filter(f=>f.level==='critical').length, high=flags.filter(f=>f.level==='high').length;
  const ov=id('overall-verdict');
  if(critical){ov.className='overall-verdict critical';ov.textContent='⬤ Directe actie vereist — '+critical+' kritieke aandachtspunten';}
  else if(high){ov.className='overall-verdict high';ov.textContent='◑ Actie vereist — '+high+' aandachtspunten';}
  else{ov.className='overall-verdict low';ov.textContent='○ Geen directe blokkades op basis van antwoorden';}

  id('module-summary').innerHTML=moduleStats().map(s=>
    '<div class="verdict-card"><div class="verdict-card-label">'+esc(MODULES[s.m].title)+'</div>'+
    '<div class="verdict-card-value '+(s.flags.some(f=>f.level==='critical')?'red':s.flags.length?'amber':'green')+'">'+
    s.answered+' / '+s.total+' beantwoord</div>'+
    '<div style="font-size:.8rem;color:var(--muted);margin-top:6px">'+s.flags.length+' aandachtspunt(en)</div></div>'
  ).join('');

  const fl=id('flags-list');
  if(!flags.length){
    fl.innerHTML='<div class="flag-card"><div class="flag-icon">🟢</div><div class="flag-body"><div class="flag-level info">Informatie</div><div class="flag-name">Geen rode vlaggen op basis van de ingevulde antwoorden</div><div class="flag-desc">Leg de beoordeling intern vast en hertoets bij wijzigingen.</div></div></div>';
  } else fl.innerHTML=flags.slice(0,50).map(renderFlag).join('');

  id('actions-list').innerHTML=buildActions(flags).map(renderFlag).join('');
  renderAnswersTable();
}

function renderFlag(f){
  const icon=f.level==='critical'?'🔴':f.level==='high'?'🟡':f.level==='medium'?'ℹ️':'🟢';
  const levelLabel=f.level==='critical'?'Directe actie':f.level==='high'?'Actie vereist':f.level==='medium'?'Aandachtspunt':'Informatie';
  return '<div class="flag-card '+(f.level==='critical'?'critical':f.level==='high'?'high':'')+'">'+
    '<div class="flag-icon">'+icon+'</div>'+
    '<div class="flag-body">'+
    '<div class="flag-level '+f.level+'">'+levelLabel+'</div>'+
    '<div class="flag-name">'+esc(f.name)+'</div>'+
    '<div class="flag-desc">'+esc(f.desc)+'</div>'+
    (f.action?'<div class="flag-desc" style="margin-top:8px;color:var(--ink);font-weight:500">→ '+esc(f.action)+'</div>':'')+
    '</div></div>';
}

function buildActions(flags){
  const out=[];
  if(flags.some(f=>/AVG|persoons|privacy/i.test(f.module+' '+f.name)))
    out.push({level:'high',name:'AVG/DPIA-controle uitvoeren',desc:'Beoordeel grondslag, rolverdeling, verwerkersovereenkomsten en eventuele DPIA-plicht.',action:'Plan een privacy review en leg bevindingen schriftelijk vast.'});
  if(flags.some(f=>/AI Act|hoog|verboden|GPAI/i.test(f.module+' '+f.name)))
    out.push({level:'high',name:'AI Act-classificatie juridisch valideren',desc:'Controleer de risicoklasse en welke rol de organisatie heeft.',action:'Maak een AI Act-verplichtingenmatrix.'});
  if(flags.some(f=>/Contract|IE|licentie|model|output/i.test(f.module+' '+f.name)))
    out.push({level:'medium',name:'Contracten en IE-clausules aanvullen',desc:'Leg datarechten, IP op model/output, aansprakelijkheid en dataportabiliteit contractueel vast.',action:'Werk contractuele addenda uit.'});
  if(!out.length)
    out.push({level:'info',name:'Documenteer de quickscan',desc:'Bewaar de ingevulde antwoorden en onderbouwing als audittrail.',action:'Hertoets bij wijzigingen in data, model of marktintroductie.'});
  return out;
}

function renderAnswersTable(){
  const tb=id('answers-tbody');
  tb.innerHTML='';
  let last='';
  for(const q of QUESTIONS){
    if(q.module!==last){
      tb.insertAdjacentHTML('beforeend','<tr><td colspan="3" style="font-size:.7rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--accent-dark);background:var(--accent-light);padding:7px 12px">'+esc(MODULES[q.module].title)+'</td></tr>');
      last=q.module;
    }
    const ans=answerText(q)||'<span style="color:var(--muted)">Niet beantwoord</span>';
    tb.insertAdjacentHTML('beforeend','<tr><td style="color:var(--accent-dark);font-weight:600;white-space:nowrap">'+q.qid+'</td><td style="color:var(--muted);max-width:360px">'+esc(q.text.slice(0,130))+(q.text.length>130?'…':'')+'</td><td style="font-weight:500">'+(ans.startsWith('<')?ans:esc(ans))+'</td></tr>');
  }
}

function buildReportText(){
  const lines=[];
  const d=new Date().toLocaleDateString('nl-NL');
  lines.push('B1 QUICKSCAN AI & DATA — RAPPORT','');
  lines.push('Organisatie: '+(idData.org||''),'Project: '+(idData.project||''),'Invuller: '+(idData.name||''),'E-mail: '+(userEmail||idData.email||''),'Datum: '+d,'');
  lines.push('BESCHRIJVING',idData.desc||'','');
  lines.push('SAMENVATTING PER MODULE');
  moduleStats().forEach(s=>lines.push(MODULES[s.m].title+': '+s.answered+'/'+s.total+' beantwoord, '+s.flags.length+' aandachtspunt(en)'));
  lines.push('','RODE VLAGGEN');
  const flags=computeFlags();
  if(!flags.length) lines.push('Geen rode vlaggen geïdentificeerd.');
  flags.forEach((f,i)=>lines.push((i+1)+'. ['+f.level.toUpperCase()+'] '+f.module+' — '+f.name+' — '+f.desc));
  lines.push('','ANTWOORDEN');
  QUESTIONS.forEach(q=>lines.push(q.qid+' '+q.text+'\nAntwoord: '+(answerText(q)||'Niet beantwoord')));
  return lines.join('\n');
}

